# Per-product factory configuration, sourced by factory/hooks/*.sh.
# /factory-init fills the values; implementation agents keep them accurate.

# Preview platform for branch test-deploys: local | coolify | do
FACTORY_PREVIEW_PLATFORM=local
FACTORY_PREVIEW_PORT=3100
FACTORY_DEV_CMD="npm run dev"
FACTORY_TEST_CMD="npm test"
FACTORY_BASE_BRANCH=main
# FACTORY_PROD_URL=            # production URL for the post-merge e2e video
# COOLIFY_URL=                 # switch FACTORY_PREVIEW_PLATFORM=coolify when set
# COOLIFY_TOKEN=
# COOLIFY_APP_UUID=
# PREVIEW_DOMAIN=              # wildcard DNS for per-branch preview URLs
